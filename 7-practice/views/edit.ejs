<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
        <a class="text-blue-500 inline-block mb-10" href="/">Go Back</a>

        <form action="/edit" method="post">
            <input class="block w-1/4 px-5 py-2 bg-zinc-800 w-full rounded-md" type="text" placeholder="Previous name"
                name="previous" value="<%= filename %>" readonly>
            <input class="block w-1/4 px-5 py-2 bg-zinc-800 w-full rounded-md mt-2" type="text" placeholder="New name"
                name="new">
            <!-- <textarea class="block px-5 py-2 mt-2 bg-zinc-800 resize-none w-full rounded-md"
                placeholder="Write your task details here..." name="description"></textarea> -->
            <input class="mt-2 bg-yellow-600 px-5 py-2 rounded-md" type="submit" value="Create Task">
        </form>
     </div>

    <script src="public/js/"></script>
</body>

</html>